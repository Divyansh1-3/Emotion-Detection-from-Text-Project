# ── P_098 Emotion Detection — example environment file ──────────────────────
# Copy to .env and fill in real values.  NEVER commit the real .env.
# The app runs fully WITHOUT an API key (LLM falls back to an offline template).

# ---- LLM (OpenAI-compatible) ------------------------------------------------
# LLM_MODE:  api  = call the provider below   |   mock = offline template only
LLM_MODE=mock
# Your key. Leave blank to force offline mode regardless of LLM_MODE.
OPENAI_API_KEY=
# Base URL of any OpenAI-compatible endpoint.
#   OpenAI:        https://api.openai.com/v1
#   Local (Ollama): http://localhost:11434/v1
#   LM Studio:     http://localhost:1234/v1
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=20
LLM_MAX_TOKENS=200

# ---- Models (Hugging Face model ids; downloaded by scripts/download_models.py)
EMOTION_MODEL=j-hartmann/emotion-english-distilroberta-base
SARCASM_MODEL=helinivan/english-sarcasm-detector
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- Decision thresholds ----------------------------------------------------
# Below this top-probability (or small margin) the result is shown as "uncertain".
UNCERTAIN_THRESHOLD=0.40
SARCASM_THRESHOLD=0.50
RETRIEVAL_TOP_K=5

# ---- Storage ----------------------------------------------------------------
# SQLite by default; swap to a postgresql://... URL for production.
DATABASE_URL=sqlite:///emotion.sqlite3

# ---- Server -----------------------------------------------------------------
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
MAX_INPUT_CHARS=4000
MAX_BATCH_ROWS=500
